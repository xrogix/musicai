<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MusicAI" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/music_accent</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="Theme.MusicAI.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.MusicAI</item>
    </style>
</resources>
